{
  "name": "birdy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && node scripts/check-alpha.mjs && tsc -b && vite build && node scripts/check-dev-pages.mjs",
    "preview": "vite preview",
    "lint": "prettier --check . && eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "check": "tsc -b",
    "tokens": "node scripts/tokens.mjs",
    "validate": "node scripts/ds-validate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.4",
    "@tanstack/react-query": "5.62.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.460.0",
    "msw": "2.6.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "fflate": "0.8.2",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.1",
    "stylelint": "16.10.0",
    "stylelint-config-css-modules": "4.4.0",
    "stylelint-config-standard": "36.0.1",
    "stylelint-declaration-strict-value": "1.10.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.16.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
